# ---------------------------------------------------------------
# Additional reviewer diagnostics; independent of the historical v7 outputs.
# Run: Rscript GRD_semiblinded_v8.R diagnostics [M]
#      Rscript GRD_semiblinded_v8.R audit /path/to/v7/full/output
# Diagnostics are not replacements for the 72-panel full simulation.
# ---------------------------------------------------------------
# Independently expressed reference implementation: scalar nested loops,
# direct per-record accumulation and covariance, no call to wald_ipw(),
# incremental_summary(), or the main routing-contribution routine.
independent_routed_wald <- function(Astar,Y,p,Q,looks,C) {
  g<-length(p); out<-rep(NA_real_,length(looks))
  mus<-matrix(NA_real_,length(looks),g)
  covs<-vector("list",length(looks))
  inverse<-solve(Q)
  for(k in seq_along(looks)) {
    n<-looks[k]; X<-matrix(0,n,g)
    for(u in seq_len(n)) for(i in seq_len(g)) {
      X[u,i]<-Y[u]*inverse[i,Astar[u]]/p[i]
    }
    mu<-vapply(seq_len(g),function(i) sum(X[,i])/n,0.0)
    V<-matrix(0,g,g)
    for(u in seq_len(n)) {
      z<-X[u,]-mu
      for(i in seq_len(g)) for(j in seq_len(g)) V[i,j]<-V[i,j]+z[i]*z[j]
    }
    V<-V/(n-1)
    H<-C%*%V%*%t(C); z<-as.vector(C%*%mu)
    eig<-tryCatch(eigen(H,symmetric=TRUE,only.values=TRUE)$values,
                  error=function(e) rep(NA_real_,nrow(C)))
    if(all(is.finite(eig)) && min(eig)>0 && min(eig)>max(eig)*1e-10)
      out[k]<-as.numeric(n*t(z)%*%solve(H,z))
    mus[k,]<-mu;covs[[k]]<-V
  }
  list(W=out,mean=mus,covariance=covs)
}

# Exact one-sided Clopper-Pearson upper confidence bound. Bonferroni
# across the *specified* rows yields simultaneous finite-grid coverage
# conditional on frozen fitted boundaries (not boundary-fit uncertainty).
one_sided_upper <- function(x,n,conf=0.95) {
  stopifnot(length(x)==1L,n>0,x>=0,x<=n,conf>0,conf<1)
  if(x==n) return(1)
  qbeta(conf,x+1,n-x)
}

finite_grid_audit <- function(path,outfile=NULL,confidence=.95) {
  if(dir.exists(path)) path<-file.path(path,"policy_metrics.csv")
  if(!file.exists(path)) stop("Cannot locate policy_metrics.csv: ",path)
  d<-read.csv(path,stringsAsFactors=FALSE)
  need<-c("policy","hypothesis","boundary","case","scenario","rejections","M","eta")
  if(!all(need %in% names(d))) stop("Missing audit columns: ",paste(setdiff(need,names(d)),collapse=", "))
  d<-subset(d,policy=="GRD" & hypothesis=="null")
  if(!nrow(d)) stop("No primary GRD null rows in input")
  if(anyDuplicated(d[c("case","scenario","boundary")])) stop("Duplicate null grid rows")
  d$simultaneous_family<-paste(d$boundary,format(d$eta,digits=8),sep="|")
  d$family_size<-as.integer(ave(rep(1,nrow(d)),d$simultaneous_family,FUN=length))
  d$one_sided_upper<-mapply(function(x,n,J)
    one_sided_upper(x,n,1-(1-confidence)/J),d$rejections,d$M,d$family_size)
  d$grid_criterion_pass<-d$one_sided_upper<=alpha
  summary<-aggregate(cbind(observed_rate=d$rejections/d$M,upper=d$one_sided_upper),
    by=list(family=d$simultaneous_family),FUN=max)
  summary$all_upper_at_most_alpha<-summary$upper<=alpha
  summary$interpretation<-"Finite nuisance grid only; conditional on fitted boundaries"
  if(is.null(outfile)) outfile<-file.path(dirname(path),"GRD_finite_grid_audit.csv")
  write.csv(d,outfile,row.names=FALSE)
  write.csv(summary,sub("\\.csv$","_summary.csv",outfile),row.names=FALSE)
  list(rows=d,summary=summary)
}

run_reviewer_diagnostics <- function(M=200L) {
  stopifnot(M>=10L)
  p<-rep(1/3,3); C<-contrast_matrix(3); looks<-c(120L,240L,360L)
  cfg<-make_cfg("IBS_review_diagnostic",3,360,0,m=-.58,K=3,p=p)
  cfg$Delta<-.47;cfg$delta<-seq(0,.47,length.out=3)
  cases<-list();verify<-list()
  for(eta in c(0,.15,.30,.50)) {
    cfg$eta<-eta;Q<-routing(p,eta);inv<-solve(Q)
    set.seed(61000000L+as.integer(eta*1000))
    for(r in seq_len(M)) {
      A<-sample.int(3,cfg$N,TRUE,prob=p)
      Y<-outcomes(A,cfg$delta,cfg$m,cfg$sigma,cfg$model)
      # Independent routing draws, with original labels retained only
      # inside this restricted synthetic diagnostic.
      Ast<-vapply(A,function(a) sample.int(3,1L,prob=Q[,a]),1L)
      Xg<-t((diag(1/p,3)%*%inv)[,Ast,drop=FALSE])*Y
      X0<-t(diag(1/p,3)[,A,drop=FALSE])*Y
      main<-wald_ipw(Xg,looks,C)
      original_AP<-wald_ipw(X0,looks,C)
      conventional<-wald_conventional(A,Y,looks,3,C)
      independent<-independent_routed_wald(Ast,Y,p,Q,looks,C)
      dm<-max(abs(colMeans(Xg)-independent$mean[3,]))
      dc<-max(abs(cov(Xg)-independent$covariance[[3]]))
      dw<-max(abs(main$W-independent$W),na.rm=TRUE)
      if(!is.finite(dw)) dw<-NA_real_
      verified<-close_numeric(main$W,independent$W,1e-8) &&
        close_numeric(colMeans(Xg),independent$mean[3,],1e-8) &&
        close_numeric(cov(Xg),independent$covariance[[3]],1e-8)
      if(!verified) stop("Independent verifier discrepancy at eta=",eta," replicate=",r)
      path_match<-close_numeric(main$W,original_AP$W,1e-10)
      if(eta==0 && (!path_match || !identical(Ast,A)))
        stop("Identity-routing pathwise equality failed")
      cases[[length(cases)+1L]]<-data.frame(eta=eta,replicate=r,
        eta_zero_path_match=if(eta==0) path_match else NA,
        W_difference_GRD_vs_unrouted_AP=max(abs(main$W-original_AP$W)),
        W_difference_GRD_vs_conventional=max(abs(main$W-conventional$W)),
        independent_verified=verified,mean_max_abs_diff=dm,
        covariance_max_abs_diff=dc,W_max_abs_diff=dw)
      verify[[length(verify)+1L]]<-data.frame(eta=eta,replicate=r,
        original_AP_W1=original_AP$W[1],GRD_W1=main$W[1])
    }
  }
  d<-do.call(rbind,cases)
  write.csv(d,file.path(outdir,"reviewer_pathwise_verification.csv"),row.names=FALSE)
  agg<-aggregate(cbind(mean_max_abs_diff,covariance_max_abs_diff,W_max_abs_diff)~eta,
                 data=d,FUN=max)
  agg$verified_replicates<-M
  agg$eta0_exact_path_matches<-ifelse(agg$eta==0,M,NA_integer_)
  write.csv(agg,file.path(outdir,"reviewer_verification_summary.csv"),row.names=FALSE)
  cat("Reviewer diagnostic completed:",nrow(d),"synthetic trials; NOT formal power evidence.\n")
  cat("Verification summary:",file.path(outdir,"reviewer_verification_summary.csv"),"\n")
  cat("Pathwise results:",file.path(outdir,"reviewer_pathwise_verification.csv"),"\n")
}

