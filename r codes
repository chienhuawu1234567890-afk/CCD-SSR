# GRD v11 RStudio-compatible reviewer revision: primary GRD-only semi-blinded monitoring; secondary confirmation.
# Standalone BASE R script. No packages required. Source in RStudio.
# Full mode evaluates all four eta values; inspect completion_audit.csv before reporting.
# Terminal: Rscript GRD_semiblinded_v11_RStudio.R smoke
# Formal:   Rscript GRD_semiblinded_v11_RStudio.R full 300000 50000 500000
# Output CSVs:
# primary_GRD_metrics.csv: primary RG only.
# GRD_reference_comparison.csv: paired RG/RO disagreement and stopping differences.
# secondary_confirmation_metrics.csv: secondary RC only.
# policy_metrics.csv: GRD, Original, Confirmation rejection rate + Wilson CI,
# MCSE, ESS, ESS MCSE, early stopping. Under null = Type I error; under
# alternative = power. Probabilities are proportions, not percentages.
# confirmation_and_delay.csv: attempts/completions/failures and delay metrics.
# *_capped: all trials, non-rejection assigned the maximum study horizon.
# *_both: conditional on both procedures rejecting; read the *_n denominator.
# O_reject_C_no_conditional: fraction of original rejections unconfirmed by RC.
# null_misspecification_sensitivity.csv: frozen-boundary null sensitivity.
# frozen_FS_boundaries.csv: fitted boundaries and precision diagnostics.
# scenario_manifest.csv / run_specification.rds / sessionInfo.txt: provenance.
#
# Formal run: 4 eta x 9 nuisance scenarios x 2 hypotheses = 72 evaluation
# panels, 50,000 trials each (3.6 million generated trials), plus calibration.
# This can take substantial time. CSVs and per-panel RDS checkpoints are
# written progressively; rerun the identical command to resume. Change the
# version tag or output directory after changing the statistical code.
# Do not report partial or smoke results as completed manuscript simulations.
# RC requires a positive GRD signal at the SAME look as a positive original
# signal. Unconfirmed crossings do NOT permanently latch the GRD signal.
# Original-label reference statistics outside requested confirmations are
# simulated counterfactuals solely for paired performance evaluation.
# Confirmation requests are not covered by routed-transcript DP; operational
# access to original labels requires the protocol's separate governance.
#
# source() defaults to diagnostics; use GRD_v11_RUN_FULL.R for manuscript simulations.
# Smoke results are implementation checks only.
atomic_saveRDS <- function(object,file,...) {
  temporary<-tempfile(pattern=".checkpoint_",tmpdir=dirname(file))
  on.exit(unlink(temporary),add=TRUE)
  saveRDS(object,temporary,...)
  if(!file.rename(temporary,file)) stop("Atomic checkpoint rename failed: ",file)
}
