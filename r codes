routing <- function(p,eta) {
  stopifnot(length(p)>=2L, all(is.finite(p)), all(p>0),
            abs(sum(p)-1)<1e-10, is.finite(eta), eta>=0, eta<1)
  Q <- (1-eta)*diag(length(p))+eta*outer(p,rep(1,length(p)))
  stopifnot(max(abs(colSums(Q)-1))<1e-10,
            min(svd(Q)$d)>1e-10)
  Q
}
privacy <- function(Q) {
  if(any(Q<=0)) return(Inf)
  max(vapply(seq_len(nrow(Q)),function(j) log(max(Q[j,])/min(Q[j,])),0.0))
}
wilson <- function(k,n,z=qnorm(.975)) {
  if(n<1) return(c(NA_real_,NA_real_))
  stopifnot(is.finite(k),is.finite(n),k>=0,k<=n)
  p <- k/n
  d <- 1+z^2/n
  center <- (p+z^2/(2*n))/d
  half <- z*sqrt(p*(1-p)/n+z^2/(4*n^2))/d
  pmax(0,pmin(1,c(center-half,center+half)))
}
