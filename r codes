# ===== V12: simultaneous finite-grid conservative first-crossing fitting =====
# All grid scenarios use ONE common boundary vector per eta. For each look
# and each grid scenario, the Clopper-Pearson upper bound for the unconditional
# first-crossing probability must be <= its spending increment. Bonferroni
# protects all (J*K) calibration constraints at family confidence 1-gamma.
# This is a statistical confidence statement for the fixed finite grid,
# NOT a deterministic uniform guarantee and NOT a continuum result.
robust_fit <- function(paths,t,alpha=.045,gamma=.05) {
  stopifnot(length(paths)>0,all(vapply(paths,is.matrix,TRUE)),
            all(vapply(paths,ncol,0L)==length(t)))
  scenario_ids <- names(paths)
  if(is.null(scenario_ids) || length(scenario_ids)!=length(paths) ||
     anyNA(scenario_ids) || any(!nzchar(scenario_ids)) ||
     anyDuplicated(scenario_ids)) {
    scenario_ids <- paste0("scenario_",seq_along(paths))
  }
  names(paths) <- scenario_ids
  J<-length(paths);K<-length(t); b<-rep(Inf,K)
  alive<-lapply(paths,function(w) rep(TRUE,nrow(w)))
  records<-list(); prev<-0
  for(k in seq_len(K)) {
    conservative_spend <- function(tt) ifelse(tt<=0,0,2*pnorm(-qnorm(1-alpha/2)/sqrt(tt)))
    increment<-conservative_spend(t[k])-conservative_spend(prev)
    # Candidate thresholds: observed finite values and Inf. Binary search
    # is unnecessary here because the number of distinct candidates can
    # be large; select the least stringent threshold meeting all bounds
    # via bisection over the pooled sorted finite statistics.
    vals<-sort(unique(unlist(lapply(seq_len(J),function(j)
      paths[[j]][alive[[j]] & is.finite(paths[[j]][,k]),k]))))
    admissible <- function(threshold) {
      all(vapply(seq_len(J),function(j) {
        x<-sum(alive[[j]] & is.finite(paths[[j]][,k]) &
               paths[[j]][,k]>=threshold)
        one_sided_upper(x,nrow(paths[[j]]),1-gamma/(J*K)) <= increment
      },TRUE))
    }
    if(length(vals)>0 && admissible(vals[length(vals)])) {
      lo<-1L;hi<-length(vals)
      while(lo<hi) {
        mid<-as.integer(floor((lo+hi)/2))
        if(admissible(vals[mid])) hi<-mid else lo<-mid+1L
      }
      b[k]<-vals[lo]
    }
    for(j in seq_len(J)) {
      hit<-alive[[j]] & is.finite(paths[[j]][,k]) &
        paths[[j]][,k]>=b[k]
      count<-sum(hit);n<-nrow(paths[[j]])
      records[[length(records)+1L]]<-data.frame(
        scenario=scenario_ids[[j]],look=k,boundary=b[k],
        target_increment=increment,crossings=count,B=n,
        estimated_increment=count/n,
        upper=one_sided_upper(count,n,1-gamma/(J*K)))
      alive[[j]][hit]<-FALSE
    }
    prev<-t[k]
  }
  list(b=b,calibration_audit=do.call(rbind,records),
       confidence=1-gamma,grid=scenario_ids)
}

robust_run <- function(B, M, gamma=.05) {
  if(B<300000L || M<50000L)
    warning("Diagnostic-size run only: do not use as manuscript evidence")
  results<-list();fits<-list(); validations<-list(); powers<-list()
  eta_grid<-c(0,.15,.30,.50)
  for(i in seq_along(eta_grid)) {
    eta<-eta_grid[i]
    cfg<-make_cfg(paste0("IBS_eta",sprintf("%.2f",eta)),3,360,eta,
                  m=-.58,K=3,p=rep(1/3,3))
    variants<-sensitivity_configs(cfg); J<-length(variants)
    scenario_ids <- names(variants)
    if(is.null(scenario_ids) || length(scenario_ids)!=J ||
       anyNA(scenario_ids) || any(!nzchar(scenario_ids)) ||
       anyDuplicated(scenario_ids)) {
      stop("Invalid nuisance scenario identifiers; cannot create auditable calibration")
    }
    t<-cfg$looks/cfg$N
    paths<-setNames(vector("list",J),scenario_ids)
    for(j in seq_len(J)) {
      cat("Robust calibration",eta,scenario_ids[[j]],"B",B,"\n")
      checkpoint<-file.path(outdir,sprintf("robust_cal_eta%.2f_%s.rds",eta,scenario_ids[[j]]))
      legacy_dir <- getOption("grd_legacy_robust_dir", NULL)
      if(!file.exists(checkpoint) && !is.null(legacy_dir)) {
        old <- file.path(legacy_dir, basename(checkpoint))
        if(file.exists(old)) {
          old_obj <- readRDS(old)
          if(!identical(old_obj$B,B) || !identical(old_obj$cfg,variants[[j]]) ||
             !is.matrix(old_obj$W) || nrow(old_obj$W)!=B ||
             ncol(old_obj$W)!=length(t)) {
            stop("Legacy checkpoint is incompatible: ",old)
          }
          # Reuse is explicitly opted into by the user, never automatic.
          atomic_saveRDS(old_obj,checkpoint)
          cat("Imported explicitly approved calibration checkpoint:",old,"\n")
        }
      }
      if(file.exists(checkpoint)) {
        obj<-readRDS(checkpoint)
        if(!identical(obj$B,B) || !identical(obj$cfg,variants[[j]]))
          stop("Calibration checkpoint mismatch: ",checkpoint)
        paths[[j]]<-obj$W
      } else {
        w<-simulate_paths(variants[[j]],B,as.integer(31000000+i*100000+j*100))
        paths[[j]]<-matrix(w[,,1],nrow=B,ncol=length(t))
        atomic_saveRDS(list(B=B,cfg=variants[[j]],W=paths[[j]]),checkpoint)
      }
    }
    cat("Fitting common robust boundaries for eta",eta,"across",J,"scenarios\n")
    fit<-robust_fit(paths,t,getOption("grd_calibration_alpha",.045),gamma)
    cat("Frozen robust boundaries:",paste(format(fit$b,digits=8),collapse=", "),"\n")
    fits[[i]]<-transform(fit$calibration_audit,eta=eta)
    atomic_saveRDS(list(b=fit$b,eta=eta,B=B,gamma=gamma,calibration_alpha=getOption("grd_calibration_alpha",.045),
                        scenarios=names(variants),source_md5=source_md5),
                   file.path(outdir,sprintf("robust_frozen_eta%.2f.rds",eta)))
    rm(paths);invisible(gc())
    for(j in seq_len(J)) for(hyp in c("null","alternative")) {
      ev<-variants[[j]]
      if(hyp=="alternative") {
        ev$Delta<-.47;ev$delta<-seq(0,.47,length.out=ev$g)
      }
      checkpoint<-file.path(outdir,sprintf("robust_eval_eta%.2f_%s_%s.rds",eta,scenario_ids[[j]],hyp))
      if(file.exists(checkpoint)) {
        obj<-readRDS(checkpoint)
        if(!identical(obj$M,M) || !identical(obj$cfg,ev))
          stop("Validation checkpoint mismatch: ",checkpoint)
        W<-obj$W
      } else {
        w<-simulate_paths(ev,M,as.integer(41000000+i*100000+j*100+if(hyp=="alternative") 1 else 0))
        W<-matrix(w[,,1],nrow=M,ncol=length(t))
        atomic_saveRDS(list(M=M,cfg=ev,W=W),checkpoint)
      }
      pol<-grd_only_paths(W,fit$b,ev$looks)
      x<-sum(pol$reject); ub<-if(hyp=="null")
        one_sided_upper(x,M,1-gamma/(length(eta_grid)*J)) else NA_real_
      results[[length(results)+1L]]<-data.frame(
        eta=eta,scenario=scenario_ids[[j]],hypothesis=hyp,
        M=M,rejections=x,rate=x/M,simultaneous_upper=ub,
        ESS=mean(pol$nstop),failed_reached=sum(pol$failed_reached),
        unresolved=sum(pol$unresolved),
        finite_grid_criterion=if(hyp=="null") ub<=alpha else NA)
    }
  }
  audit<-do.call(rbind,fits); val<-do.call(rbind,results)
  write.csv(audit,file.path(outdir,"robust_calibration_audit.csv"),row.names=FALSE)
  write.csv(val,file.path(outdir,"robust_independent_validation.csv"),row.names=FALSE)
  summary<-aggregate(simultaneous_upper~eta,data=subset(val,hypothesis=="null"),FUN=max)
  summary$passes_finite_grid<-summary$simultaneous_upper<=alpha
  summary$simultaneous_family <- "all eta x all null scenarios"
  write.csv(summary,file.path(outdir,"robust_finite_grid_summary.csv"),row.names=FALSE)
  writeLines(c(paste("Calibration target:",getOption("grd_calibration_alpha",.045)),"Validation target: 0.05", "Robust run completed; inspect all checkpoint and audit files.",
    "Finite-grid confidence bounds are conditional on frozen fitted boundaries.",
    "This does not prove nuisance-continuum or unconditional calibration-algorithm control."),
    file.path(outdir,"ROBUST_COMPLETE.txt"))
  summary
}
